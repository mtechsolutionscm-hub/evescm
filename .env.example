# EVES MSC server authentication
EVES_ADMIN_EMAIL=your-admin-email@example.com
EVES_ADMIN_PASSWORD=use-a-strong-unique-password
EVES_ADMIN_SESSION_SECRET=generate-a-long-random-secret

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Vite browser realtime client (publishable key is safe to expose with RLS)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
