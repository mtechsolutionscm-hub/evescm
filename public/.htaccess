# EVES static hosting rules
Options -Indexes

RewriteEngine On
RewriteBase /

# Never expose the physical gallery directory; send visitors to the app gallery section.
RewriteRule ^gallery/?$ /#gallery [R=302,L]

# SPA fallback for client-side routes.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
