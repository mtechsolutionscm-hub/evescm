# EVES static hosting rules
Options -Indexes

RewriteEngine On
RewriteBase /

# SPA fallback. The /gallery route is a React route; gallery assets live outside
# the /gallery URL directory so Apache never exposes a directory index.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
